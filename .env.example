# flowcode reads its Tinker credential from the WORKSPACE-ROOT .env (see [env] in mise.toml),
# not from this directory. This file documents the variables; copy the ones you need into
# ../.env at the monorepo root.

# Required. Your Tinker API key.
TINKER_API_KEY=

# Optional. Groups runs under a Tinker project.
# TINKER_PROJECT_ID=

# Optional. Runs sampling in a sidecar subprocess to dodge GIL contention with the training
# loop. Worth setting for large rollout batches.
# TINKER_SUBPROCESS_SAMPLING=1

# Optional. Enables the wandb logger (`--logger wandb`).
# WANDB_API_KEY=
